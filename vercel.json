{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/work", "destination": "/index.html" },
    { "source": "/stills", "destination": "/index.html" },
    { "source": "/services", "destination": "/index.html" },
    { "source": "/capabilities", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
